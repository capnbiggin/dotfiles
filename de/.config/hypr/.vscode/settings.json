{
  "editor.fontFamily": "JetBrainsMono Nerd Font Propo",
  "editor.fontSize": 14,
  "editor.allowVariableFonts": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 12,
  "editor.fontLigatures": true,

  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  
  // Indent Guides and Bracket Pair Colorization
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.bracketPairColorization.enabled": true,
  "workbench.colorCustomizations": {
    // indent guide colors
    "editorIndentGuide.background1": "#f38ba89e",
    "editorIndentGuide.activeBackground1": "#f38ba8",
    "editorIndentGuide.background2": "#fab38799",
    "editorIndentGuide.activeBackground2": "#fab387",
    "editorIndentGuide.background3": "#f9e2af99",
    "editorIndentGuide.activeBackground3": "#f9e2af",
    "editorIndentGuide.background4": "#a6e3a199",
    "editorIndentGuide.activeBackground4": "#a6e3a1",
    "editorIndentGuide.background5": "#74c6ec99",
    "editorIndentGuide.activeBackground5": "#74c6ec",
    "editorIndentGuide.background6": "#b4befe99",
    "editorIndentGuide.activeBackground6": "#b4befe",

    // Bracket Colors
    "editorBracketHighlight.foreground1": "#f38ba8",
    "editorBracketHighlight.foreground2": "#fab387",
    "editorBracketHighlight.foreground3": "#f9e2af",
    "editorBracketHighlight.foreground4": "#a6e3a1",
    "editorBracketHighlight.foreground5": "#74c6ec",
    "editorBracketHighlight.foreground6": "#b4befe",
    "editorBracketHighlight.unexpectedBracket.foreground": "#d50000",

    // Error, Warning & Info colors
    "editorError.background": "#ff80ab66",
    "editorError.foreground": "#d50000",
    "editorWarning.background": "#fff98066",
    "editorWarning.foreground": "#d5d500",
    "editorInfo.background": "#ffe38045",
    "editorInfo.foreground": "#d58e00",
  },

  "editor.defaultFormatter": "sumneko.lua",

  "cSpell.words": [
    "awww",
    "blueman",
    "capn",
    "catppuccin",
    "cliphist",
    "colresize",
    "cyclenext",
    "cycleprev",
    "dmenu",
    "ghostty",
    "halign",
    "hypr",
    "hyprlock",
    "hyprpolkitagent",
    "keybinds",
    "numlock",
    "numpad",
    "onclick",
    "pavucontrol",
    "popin",
    "pulseaudio",
    "quickshell",
    "rgba",
    "rofi",
    "swapcol",
    "thunar",
    "windowrule",
    "xwayland",
    "zeditor",
    "zennotes"
  ]
}
