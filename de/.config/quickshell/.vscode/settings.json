{
  "cSpell.words": [
    "opsz",
    "paru",
    "Pipewire",
    "Propo",
    "Quickshell",
    "rgba",
    "shellroot",
    "wght"
  ],
  "editor.fontFamily": "JetBrainsMono Nerd Font Propo",
  "editor.defaultFormatter": "Delgan.qml-format",
  "qmlFormat.command": "/usr/lib/qt6/bin/qmlformat",
  "qmlFormat.extraArguments": [
    "--indent-width",
    "2"
  ],
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
}